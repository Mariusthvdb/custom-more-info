{
  "compilerOptions": {
    "outDir": "./",
    "module": "esnext",
    "target": "es6",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": false,
    "noImplicitAny": false,
    "removeComments": true,
    "baseUrl": "./src",
    "rootDir": "src",
    "allowJs": true,
    "paths": {
      "@types": ["types"],
      "@constants": ["constants"],
      "@utilities": ["utilities"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
